# HimDrishti — Environment Variables Example
# SIH 2026 · PS 26059
#
# Copy this file to .env.local (frontend) or .env (backend) and fill in values.
# NEVER commit .env or .env.local files — they are in .gitignore.
#
# ================================================================
# BACKEND ENVIRONMENT VARIABLES
# ================================================================

# ALLOWED_ORIGINS
# Comma-separated list of frontend origins to allow in CORS.
# Development default (built into backend/main.py):
#   http://localhost:5173,http://127.0.0.1:5173
# Production (set in Render dashboard or .env):
#   ALLOWED_ORIGINS=https://himdrishti-ui.onrender.com
ALLOWED_ORIGINS=

# ================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================================================
# Place these in frontend/.env.local for local overrides.

# VITE_API_BASE_URL
# The base URL of the FastAPI backend.
# Development default (built into frontend/src/services/api/config.ts):
#   http://localhost:8000
# Production (set in Render dashboard or frontend/.env.local):
#   VITE_API_BASE_URL=https://himdrishti-api.onrender.com
VITE_API_BASE_URL=
