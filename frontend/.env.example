# HimDrishti — Frontend Environment Variables
# SIH 2026 · PS 26059
#
# Copy this file to .env.local and fill in values for your environment.
# NEVER commit .env.local — it is in .gitignore.
#
# ─────────────────────────────────────────────────────────────
# SECURITY RULES:
#   - VITE_* variables are bundled into the frontend build and
#     visible to anyone who opens the browser DevTools.
#   - NEVER put API keys, passwords, or secrets in VITE_* vars.
#   - Backend credentials (CMEMS, CDS, NASA EarthData) belong in
#     the BACKEND environment only, not here.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Development default — Vite dev server talks to local uvicorn
VITE_API_BASE_URL=http://localhost:8000
